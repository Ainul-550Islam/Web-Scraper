# Reference nginx config for the harvest console static bundle.
# Serves on 8080 and proxies /api/* to the engine's admin endpoint so the
# console can run token-less on a trusted network (the in-app bearer path
# stays available for direct deployments — docs/adr/0006).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hash routing means every path is a static asset; unknown paths 404 on
    # purpose (docs/api.md's index is the engine's, not this server's).
    location / {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff;
        add_header X-Frame-Options DENY;
        add_header Referrer-Policy no-referrer;
    }

    location ~* \.(js|css|html)$ {
        # Vite emits content-hashed asset names; index.html must never be
        # cached or users pin themselves to stale chunks.
        expires off;
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:9678/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
        # Engine errors must reach the browser untouched: the console owns
        # the retry/redaction policy (docs/adr/0003, 0008).
        proxy_intercept_errors off;
    }
}
