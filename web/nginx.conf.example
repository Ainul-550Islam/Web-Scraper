# Reference nginx config for the harvest console static bundle.
# Serves on 8080 and proxies /api/* to the engine's admin endpoint so the
# console can run token-less on a trusted network (the in-app bearer path
# stays available for direct deployments — docs/adr/0006).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hash routing keeps client routes in the fragment: `/` uses the index
    # directive, while unknown file paths retain nginx's normal 404 (the API
    # index lives in the engine, not this static server).
    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }

    location ~* \.(js|css|html)$ {
        # Vite emits content-hashed asset names; index.html must never be
        # cached or users pin themselves to stale chunks.
        expires off;
        add_header Cache-Control "no-cache";
        # Nginx stops inheriting parent-level add_header directives as soon
        # as this location declares Cache-Control, so repeat the security
        # headers here for the index and content-hashed static assets.
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:9678/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_read_timeout 30s;
        proxy_buffering off;
        # Engine errors must reach the browser untouched: the console owns
        # the retry/redaction policy (docs/adr/0003, 0008).
        proxy_intercept_errors off;
    }
}
