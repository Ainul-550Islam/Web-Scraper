{
  "_note": "Compose starter config. Replace the loopback demo target with sources you are authorized to crawl. Keep file paths under /var/lib/harvest. Compose binds the host port to 127.0.0.1; this in-container 0.0.0.0 bind is required for the console and Prometheus services and is protected by the injected admin token.",
  "name": "harvest-compose-demo",
  "user_agent": "harvest/0.10 (authorized data collection; contact: ops@example.com)",
  "respect_robots": true,
  "concurrency": 2,
  "request_timeout_secs": 20,
  "connect_timeout_secs": 10,
  "max_retries": 2,
  "retry_base_ms": 500,
  "max_single_wait_ms": 15000,
  "max_response_bytes": 16777216,
  "max_pages": 50,
  "audit_path": "/var/lib/harvest/audit.json",
  "dlq_path": "/var/lib/harvest/dlq.jsonl",
  "ckpt_path": "/var/lib/harvest/state.ckpt",
  "ckpt_every_secs": 30,
  "ckpt_every_pages": 250,
  "revalidate_store": "/var/lib/harvest/validators.jsonl",
  "revalidate_ttl_secs": 0,
  "dlq_max_attempts": 3,
  "default_policy": {
    "requests_per_sec": 1.0,
    "burst": 2,
    "min_interval_ms": 500
  },
  "block_backoff_secs": 60,
  "block_breaker_count": 5,
  "robots_ttl_secs": 3600,
  "proxies": [
    {
      "id": "direct"
    }
  ],
  "targets": [
    {
      "id": "demo-target",
      "start_url": "http://127.0.0.1:8099/",
      "max_depth": 0,
      "follow_links": false,
      "max_pages": 1,
      "extract": {
        "title": {
          "css": "h1"
        }
      }
    }
  ],
  "output": {
    "kind": "jsonl",
    "path": "/var/lib/harvest/results.jsonl"
  },
  "metrics_addr": "0.0.0.0:9678",
  "schedule": {
    "every_secs": 3600,
    "runs": 0,
    "history_path": "/var/lib/harvest/runs.jsonl"
  },
  "admin_token": "${HARVEST_ADMIN_TOKEN}",
  "alerts": {
    "webhook_url": null,
    "events": [
      "run_error",
      "no_data",
      "high_block_rate"
    ],
    "min_records": 1,
    "max_block_rate": 0.4
  }
}
