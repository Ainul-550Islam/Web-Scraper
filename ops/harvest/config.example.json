{
  "_note": "Compose starter config. Replace the loopback demo target with sources you are authorized to crawl. Keep file paths under /var/lib/harvest. Compose binds the host port to 127.0.0.1; this in-container 0.0.0.0 bind is required for the console and Prometheus services and is protected by the injected admin token.",
  "name": "harvest-compose-demo",
  "user_agent": "harvest/0.10 (authorized data collection; contact: ops@example.com)",
  "respect_robots": true,
  "concurrency": 2,
  "request_timeout_secs": 20,
  "connect_timeout_secs": 10,
  "max_retries": 2,
  "retry_base_ms": 500,
  "max_single_wait_ms": 15000,
  "max_response_bytes": 16777216,
  "max_pages": 50,
  "audit_path": "/var/lib/harvest/audit.json",
  "dlq_path": "/var/lib/harvest/dlq.jsonl",
  "ckpt_path": "/var/lib/harvest/state.ckpt",
  "ckpt_every_secs": 30,
  "ckpt_every_pages": 250,
  "revalidate_store": "/var/lib/harvest/validators.jsonl",
  "revalidate_ttl_secs": 0,
  "dlq_max_attempts": 3,
  "default_policy": {
    "requests_per_sec": 1.0,
    "burst": 2,
    "min_interval_ms": 500
  },
  "block_backoff_secs": 60,
  "block_breaker_count": 5,
  "robots_ttl_secs": 3600,
  "proxies": [
    {
      "id": "direct"
    }
  ],
  "targets": [
    {
      "id": "demo-target",
      "start_url": "http://127.0.0.1:8099/",
      "max_depth": 0,
      "follow_links": false,
      "max_pages": 1,
      "extract": {
        "title": {
          "css": "h1"
        }
      }
    }
  ],
  "output": {
    "kind": "jsonl",
    "path": "/var/lib/harvest/results.jsonl"
  },
  "metrics_addr": "0.0.0.0:9678",
  "schedule": {
    "every_secs": 3600,
    "runs": 0,
    "history_path": "/var/lib/harvest/runs.jsonl"
  },
  "admin_token": "${HARVEST_ADMIN_TOKEN}",
  "alerts": {
    "webhook_url": null,
    "events": [
      "run_error",
      "no_data",
      "high_block_rate"
    ],
    "min_records": 1,
    "max_block_rate": 0.4
  },
  "managed_api": {
    "enabled": false,
    "data_dir": "/var/lib/harvest/managed-api",
    "ledger_dir": "/var/lib/harvest/managed-api/ledger",
    "export_dir": "/var/lib/harvest/managed-api/exports",
    "allow_private_targets": false,
    "max_request_bytes": 65536,
    "max_redirects": 5,
    "request_timeout_ms": 60000,
    "max_url_len": 2048,
    "webhook_url_max_len": 2048,
    "max_records": 5000,
    "extract_max_fields": 128,
    "render_timeout_ms": 30000,
    "idempotency_retention_ms": 86400000,
    "idempotency_max_records": 1000,
    "max_keys_per_tenant": 50,
    "default_limits": {
      "rps": 5.0,
      "burst": 10,
      "max_concurrent_jobs": 2,
      "monthly_quota": 100000,
      "max_response_bytes": 16777216,
      "allowed_domains": [],
      "scopes": [
        "scrape"
      ]
    },
    "pricing": {
      "base_units": 1,
      "render_units": 3,
      "screenshot_units": 2,
      "proxy_region_units": {},
      "per_1k_bytes": 1,
      "extract_units": 1,
      "selector_units": 2,
      "transform_units": 1,
      "artifact_units_per_k": 1,
      "currency": "USD",
      "rate": 1e-05
    },
    "jobs": {
      "max_jobs": 5000,
      "ttl_secs": 604800,
      "enabled": true,
      "workers": 2,
      "max_browser_ms": 30000,
      "max_records": 5000,
      "max_interval_minutes": 1440,
      "jobs_max_list": 200
    },
    "webhook": {
      "max_attempts": 5,
      "timeout_ms": 10000,
      "retry_base_ms": 1000,
      "retry_cap_ms": 30000,
      "dead_letter_path": "/var/lib/harvest/managed-api/dead-letter.jsonl",
      "enabled": false,
      "allowed_hosts": [],
      "retry_schedule_ms": [],
      "delivery_key": "dev-only-delivery-key",
      "dead_letter_salt": "dev-only-dead-letter-salt",
      "list_max": 500
    }
  },
  "_managed_api_note": "Managed scrape API section (disabled by default). Set `enabled: true` to mount /v1/* alongside the console on this listener. Paths must stay under /var/lib/harvest. `allow_private_targets` stays false in any deployment that can reach metadata or loopback services \u2014 it is a demo/test escape hatch and startup warns when it is on."
}
