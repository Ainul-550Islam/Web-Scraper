# systemd unit for the engine (docs/deployment.md).
# The static console is served separately by nginx/Caddy on the same origin.
[Unit]
Description=harvest crawler engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harvest
Group=harvest
WorkingDirectory=/var/lib/harvest
ExecStart=/usr/local/bin/harvest serve --config /etc/harvest/config.json
Restart=always
RestartSec=2
EnvironmentFile=-/etc/harvest/harvest.env
KillSignal=SIGTERM
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/harvest
# The admin API includes authenticated mutation endpoints. Bind loopback
# and preserve the browser Host/Origin through a same-origin TLS proxy.
ExecStartPre=/bin/sh -c 'test -r /etc/harvest/config.json'

[Install]
WantedBy=multi-user.target
