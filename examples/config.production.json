{
  "_note": "Hardened single-node production template. Secrets come from the environment only (whole-value ${VAR}); validate with dummies:  HARVEST_ADMIN_TOKEN=devtoken12345678 ALERT_WEBHOOK=https://hooks.example.com/harvest cargo run -- validate --config examples/config.production.json  For signed receipts also set attest_key_path to a 0600 key (harvest attest --gen-key …) — deliberately absent here so the file passes validate on any box.",
  "name": "harvest-prod",
  "user_agent": "harvest/0.9 (data collection on contract; contact: data@example.com)",
  "respect_robots": true,
  "concurrency": 8,
  "request_timeout_secs": 20,
  "connect_timeout_secs": 5,
  "max_retries": 2,
  "max_response_bytes": 8388608,
  "max_pages": 20000,
  "block_backoff_secs": 120,
  "block_breaker_count": 4,
  "dlq_path": "out/dlq.jsonl",
  "ckpt_path": "out/state.ckpt",
  "revalidate_store": "out/validators.jsonl",
  "revalidate_ttl_secs": 86400,
  "audit_path": "out/audit.json",
  "default_policy": { "requests_per_sec": 1.0, "burst": 2, "min_interval_ms": 500 },
  "domain_policies": {
    "data.example.com": { "requests_per_sec": 2.0, "burst": 4, "min_interval_ms": 250 }
  },
  "metrics_addr": "127.0.0.1:9678",
  "admin_token": "${HARVEST_ADMIN_TOKEN}",
  "schedule": { "every_secs": 3600, "runs": 0, "history_path": "out/runs.jsonl" },
  "alerts": {
    "webhook_url": "${ALERT_WEBHOOK}",
    "events": ["no_data", "high_block_rate", "run_error"],
    "min_records": 1,
    "max_block_rate": 0.05
  },
  "targets": [
    {
      "id": "catalog-pages",
      "start_url": "https://shop.example.com/new-arrivals",
      "follow_links": true,
      "max_depth": 2,
      "link_selector": "a.product-card",
      "exclude": ["/account", "/cart"],
      "max_pages": 400,
      "sitemap": true,
      "extract": {
        "title": { "css": "h1" },
        "price": { "css": "meta[property=\"og:price:amount\"]", "attr": "content" },
        "currency": { "css": "meta[property=\"og:price:currency\"]", "attr": "content" },
        "image": { "css": "img.product-hero", "attr": "src" }
      }
    },
    {
      "id": "api-stock",
      "start_url": "https://data.example.com/api/v1/stock",
      "mode": "json",
      "max_pages": 1,
      "extract": {
        "sku": { "path": "$.items[*].sku" },
        "qty": { "path": "$.items[*].qty" }
      }
    }
  ],
  "output": { "kind": "sqlite", "path": "out/harvest.db" }
}
